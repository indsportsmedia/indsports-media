rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Staff who can always upload. Add a teammate's Google email here (lowercase)
    // if their uploads are refused.
    function isListed() {
      return request.auth.token.email.lower() in [
        'indsportsmedia1@gmail.com'
      ];
    }

    // Also allows anyone on the Newsroom team list (Firestore staff/{email}).
    // This part only works once Storage is allowed to read Firestore.
    function onStaffList() {
      return firestore.exists(/databases/(default)/documents/staff/$(request.auth.token.email.lower()));
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (isListed() || onStaffList());
    }

    function isMedia() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*');
    }

    // Anyone can view. Only staff can upload, replace or delete. 500 MB per file.
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isMedia() && request.resource.size < 500 * 1024 * 1024;
      allow delete: if isStaff();
    }
  }
}

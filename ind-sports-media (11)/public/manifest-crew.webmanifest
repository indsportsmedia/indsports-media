{
  "name": "IND Crew",
  "short_name": "IND Crew",
  "description": "IND Sports Media staff tools: Scorekeeper and Newsroom.",
  "id": "/newsroom",
  "start_url": "/newsroom?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "/icon-crew-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-crew-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-crew-maskable-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Scorekeeper", "url": "/score", "icons": [{ "src": "/icon-crew-192.png?v=2", "sizes": "192x192" }] },
    { "name": "Post live update", "url": "/newsroom", "icons": [{ "src": "/icon-crew-192.png?v=2", "sizes": "192x192" }] }
  ]
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isValidId(gameId);

      match /clips/{clipId} {
        allow read: if true;
        allow write: if isValidId(clipId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
